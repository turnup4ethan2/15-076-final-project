# Secrets — NEVER commit
.env
.env.local

# Raw data — re-downloadable from MITECO/AEMET/CSIC/MAPA, too large for git
data/raw/

# Processed data — generated by ingest scripts, regeneratable from raw
# Hand-curated reference files (guadalquivir_*.csv) are kept; everything else is generated.
data/processed/*
!data/processed/guadalquivir_*.csv
!data/processed/.gitkeep

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Jupyter
.ipynb_checkpoints/
*.ipynb_checkpoints

# Conda / virtualenvs (envs live outside the repo, but just in case)
.venv/
venv/
env/

# Julia
optimization/Manifest.toml
optimization/.julia_history

# Regenerated by optimization/plot_allocations.py (keep directory via .gitkeep)
optimization/figures/*.png

# OS / editor cruft
.DS_Store
.idea/
.vscode/
*.swp

# Claude Code project state
.claude/
