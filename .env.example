# AEMET OpenData API key
# Get one at https://opendata.aemet.es/centrodedescargas/altaUsuario
#
# Setup: copy this file to .env in the same directory, then paste your key
# below. The .env file must NEVER be committed to git — when you add a
# .gitignore, .env should be the first entry.
AEMET_API_KEY=your_key_here
